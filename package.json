{
  "name": "goos-ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && tsc --noEmit -p test/tsconfig.json",
    "test:e2e": "npm run build && playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@vueuse/nuxt": "^14.4.0",
    "@xmpp/client": "^0.14.0",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/xmpp__client": "^0.14.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9"
  },
  "volta": {
    "node": "26.2.0",
    "npm": "11.15.0"
  }
}
