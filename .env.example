# Used by `npm run fake-auction:remote` (tools/fake-auction.ts --remote) to
# connect to a remote Redis instance (e.g. the one deployed on Render)
# instead of localhost.
# Copy this file to .env.local and fill in the real value.
REDIS_URL=rediss://host

# Used by `npm run fake-auction:xmpp:remote` / `npm run test:integration:xmpp`
# (--remote) to connect to the deployed Prosody instead of localhost. See
# poc/docs/xmpp-prosody-deploy.md.
XMPP_SERVICE_URL=wss://host/xmpp-websocket
XMPP_DOMAIN=host
