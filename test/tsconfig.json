{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@server/*": ["../server/*"],
      "@app/*": ["../app/*"],
      "@test/*": ["./*"]
    }
  },
  "include": ["**/*.ts"]
}
