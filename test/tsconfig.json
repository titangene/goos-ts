{
  // test/ 不屬於 Nuxt app（不在 nuxt.config.ts 的 srcDir 範圍內），Nuxt 不會
  // 幫忙產生 .nuxt/tsconfig.*.json，需要這個獨立的 tsconfig 才能讓
  // `npm run typecheck`、編輯器涵蓋到它。
  //
  // extends ../.nuxt/tsconfig.json：Nuxt 自動產生、合併了 nuxt.config.ts 的
  // alias（@server/@app/@shared/@test）與其他基本編譯選項，改別名時不用
  // 再手動同步一份到這裡。
  "extends": "../.nuxt/tsconfig.json",
  "include": ["**/*.ts"],
  // integration/app/ 會 import .vue 元件（見 nuxt.config.ts 的
  // typescript.tsConfig.include），已經被納入 Nuxt app context，由
  // `nuxt typecheck`（vue-tsc，真的懂 .vue）負責，這裡排除掉避免用不懂
  // .vue 的純 tsc 重複檢查同一批檔案。
  "exclude": ["integration/app/**"]
}
